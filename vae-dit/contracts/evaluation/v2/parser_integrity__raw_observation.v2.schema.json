{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "run", "dataset", "availability"],
  "properties": {
    "schema_version": {"const": "parser_integrity_raw_observation.v2"},
    "status": {"enum": ["AVAILABLE", "UNAVAILABLE"]},
    "run": {"$ref": "#/$defs/run"},
    "dataset": {"type": "object", "required": ["identity", "content_sha256"]},
    "availability": {"type": "object", "required": ["raw_capture", "measure_map"], "properties": {"raw_capture": {"type": "boolean"}, "measure_map": {"type": "boolean"}}},
    "measure_map": {"type": "object", "required": ["song_count", "measure_count", "meter_distribution", "opus_tune_count", "over_capacity_count"]},
    "initial_time_signature_policy": {"enum": ["error", "smf_default_4_4"]},
    "initial_time_signature_origin_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "initial_time_signature_injections": {"type": "array", "items": {"type": "object", "required": ["source_file_identity", "origin", "injected_at_tick", "meter", "first_real_ts_tick"], "properties": {"source_file_identity": {"type": "string"}, "origin": {"const": "smf_default"}, "injected_at_tick": {"const": 0}, "meter": {"const": "4/4"}, "first_real_ts_tick": {"type": ["integer", "null"], "minimum": 1}}, "additionalProperties": true}},
    "track_retention": {"type": "object", "required": ["hard_safety_limit", "policy", "dropped_part_count", "dropped_note_count", "dropped_note_ratio"]},
    "normalization_policy_version": {"const": "raw_pairing_normalization.v1"},
    "repair_artifact": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "repair_count": {"type": "integer", "minimum": 0},
    "repair_counts_by_kind": {"type": "object"},
    "repair_affected_file_count": {"type": "integer", "minimum": 0},
    "partial_span_count": {"type": "integer", "minimum": 0},
    "partial_reason_counts": {"type": "object", "additionalProperties": false, "required": ["time_signature_change"], "properties": {"time_signature_change": {"type": "integer", "minimum": 0}}},
    "partial_spans": {"type": "array", "items": {"$ref": "#/$defs/partial"}},
    "parser_failures": {"type": "array"},
    "unavailable_reasons": {"type": "array"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "AVAILABLE"}}}, "then": {"required": ["measure_map", "initial_time_signature_policy", "initial_time_signature_origin_counts", "initial_time_signature_injections", "track_retention", "normalization_policy_version", "repair_artifact", "repair_count", "repair_counts_by_kind", "repair_affected_file_count", "partial_span_count", "partial_reason_counts", "partial_spans", "parser_failures"], "properties": {"availability": {"properties": {"raw_capture": {"const": true}, "measure_map": {"const": true}}}}}},
    {"if": {"properties": {"status": {"const": "UNAVAILABLE"}}}, "then": {"required": ["unavailable_reasons"], "properties": {"availability": {"properties": {"raw_capture": {"const": false}}}}}}
  ],
  "$defs": {
    "run": {"type": "object", "required": ["encoding_manifest_sha256", "bar_tensor_index_sha256", "tensor_schema_version"], "properties": {"encoding_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "bar_tensor_index_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "tensor_schema_version": {"const": "bar_tensor_schema.v2"}}},
    "partial": {"type": "object", "additionalProperties": false, "required": ["source_file_identity", "tune_index", "canonical_bar_index", "canonical_start_tick", "canonical_end_tick", "ppqn", "actual_bar_length_ql", "nominal_meter", "partial_reason", "triggering_ts_tick", "triggering_ts_provenance"], "properties": {"source_file_identity": {"type": "string", "minLength": 1}, "tune_index": {"type": "integer", "minimum": 0}, "canonical_bar_index": {"type": "integer", "minimum": 0}, "canonical_start_tick": {"type": "integer", "minimum": 0}, "canonical_end_tick": {"type": "integer", "minimum": 1}, "ppqn": {"type": "integer", "minimum": 1}, "actual_bar_length_ql": {"type": "number", "exclusiveMinimum": 0}, "nominal_meter": {"type": "string"}, "partial_reason": {"const": "time_signature_change"}, "triggering_ts_tick": {"type": "integer", "minimum": 0}, "triggering_ts_provenance": {"type": "object", "required": ["physical_track_index", "event_ordinal", "numerator", "denominator"]}}}
  }
}
