{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codec V2 fragment-level quantization audit raw observation",
  "type": "object",
  "required": ["schema_version", "status", "run", "dataset", "availability"],
  "properties": {
    "schema_version": {"const": "quantization_audit_raw_observation.v2"},
    "status": {"enum": ["AVAILABLE", "UNAVAILABLE"]},
    "run": {"$ref": "#/$defs/run"}, "dataset": {"$ref": "#/$defs/dataset"}, "availability": {"$ref": "#/$defs/availability"},
    "audit_unit": {"const": "source_note_fragment"}, "fragment_count": {"type": "integer", "minimum": 0},
    "grid_policy": {"$ref": "#/$defs/gridPolicy"}, "by_file_meter": {"type": "array", "items": {"$ref": "#/$defs/fileMeter"}},
    "residual_samples": {"$ref": "#/$defs/residualSamples"}, "unavailable_reasons": {"type": "array", "items": {"$ref": "#/$defs/reason"}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "AVAILABLE"}}}, "then": {"required": ["audit_unit", "fragment_count", "grid_policy", "by_file_meter", "residual_samples", "unavailable_reasons"], "properties": {"availability": {"properties": {"raw_capture": {"const": true}, "source_boundaries": {"const": true}, "residual_samples": {"const": true}}}, "unavailable_reasons": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"const": "UNAVAILABLE"}}}, "then": {"required": ["unavailable_reasons"], "properties": {"availability": {"properties": {"raw_capture": {"const": false}, "source_boundaries": {"const": false}, "residual_samples": {"const": false}}}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "run": {"type": "object", "required": ["encoding_manifest_sha256", "bar_tensor_index_sha256", "tensor_schema_version"], "properties": {"encoding_manifest_sha256": {"$ref": "#/$defs/sha256"}, "bar_tensor_index_sha256": {"$ref": "#/$defs/sha256"}, "tensor_schema_version": {"const": "bar_tensor_schema.v2"}}, "additionalProperties": false},
    "dataset": {"type": "object", "required": ["identity", "content_sha256"], "properties": {"identity": {"type": "string", "minLength": 1}, "content_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}}, "additionalProperties": false},
    "availability": {"type": "object", "required": ["raw_capture", "source_boundaries", "residual_samples"], "properties": {"raw_capture": {"type": "boolean"}, "source_boundaries": {"type": "boolean"}, "residual_samples": {"type": "boolean"}}, "additionalProperties": false},
    "gridPolicy": {"type": "object", "required": ["quantum_ql", "epsilon_ql", "capacity"], "properties": {"quantum_ql": {"const": 0.25}, "epsilon_ql": {"const": 0.000001}, "capacity": {"const": 48}}, "additionalProperties": false},
    "residual": {"type": "object", "required": ["max", "p95"], "properties": {"max": {"type": "number", "minimum": 0}, "p95": {"type": "number", "minimum": 0}}, "additionalProperties": false},
    "fileMeter": {"type": "object", "required": ["source_file_identity", "tune_index", "meter", "fragment_count", "nonzero_residual_count", "onset_residual_ql", "end_residual_ql"], "properties": {"source_file_identity": {"type": "string", "minLength": 1}, "tune_index": {"type": "integer", "minimum": 0}, "meter": {"type": "string", "pattern": "^[1-9][0-9]*/[1-9][0-9]*$"}, "fragment_count": {"type": "integer", "minimum": 0}, "nonzero_residual_count": {"type": "integer", "minimum": 0}, "onset_residual_ql": {"$ref": "#/$defs/residual"}, "end_residual_ql": {"$ref": "#/$defs/residual"}}, "additionalProperties": false},
    "arrayDescriptor": {"type": "object", "required": ["dtype", "shape"], "properties": {"dtype": {"type": "string", "minLength": 1}, "shape": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 1, "maxItems": 1}}, "additionalProperties": false},
    "residualSamples": {"type": "object", "required": ["path", "sha256", "arrays"], "properties": {"path": {"const": "quantization_residual_samples.v2.npz"}, "sha256": {"$ref": "#/$defs/sha256"}, "arrays": {"type": "object", "required": ["source_file_identities", "tune_indexes", "meters", "group_offsets", "source_note_ids", "canonical_bar_indexes", "raw_local_start_ql", "raw_local_end_ql", "quantized_local_start_ql", "quantized_local_end_ql", "onset_residuals_ql", "end_residuals_ql"], "properties": {"source_file_identities": {"$ref": "#/$defs/arrayDescriptor"}, "tune_indexes": {"$ref": "#/$defs/arrayDescriptor"}, "meters": {"$ref": "#/$defs/arrayDescriptor"}, "group_offsets": {"$ref": "#/$defs/arrayDescriptor"}, "source_note_ids": {"$ref": "#/$defs/arrayDescriptor"}, "canonical_bar_indexes": {"$ref": "#/$defs/arrayDescriptor"}, "raw_local_start_ql": {"$ref": "#/$defs/arrayDescriptor"}, "raw_local_end_ql": {"$ref": "#/$defs/arrayDescriptor"}, "quantized_local_start_ql": {"$ref": "#/$defs/arrayDescriptor"}, "quantized_local_end_ql": {"$ref": "#/$defs/arrayDescriptor"}, "onset_residuals_ql": {"$ref": "#/$defs/arrayDescriptor"}, "end_residuals_ql": {"$ref": "#/$defs/arrayDescriptor"}}, "additionalProperties": false}}, "additionalProperties": false},
    "reason": {"type": "object", "required": ["field", "reason"], "properties": {"field": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
