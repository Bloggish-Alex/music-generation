{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "status", "run", "dataset", "availability", "unavailable_reasons"],
  "properties": {
    "schema_version": {"const": "performance_controls_raw_observation.v2"},
    "status": {"enum": ["AVAILABLE", "UNAVAILABLE"]},
    "run": {"$ref": "#/$defs/run"},
    "dataset": {"type": "object", "required": ["identity", "content_sha256"], "properties": {"identity": {"type": "string"}, "content_sha256": {"type": ["string", "null"]}}, "additionalProperties": false},
    "availability": {"type": "object", "required": ["raw_capture", "tempo", "key", "velocity", "cc64"], "properties": {"raw_capture": {"type": "boolean"}, "tempo": {"type": "boolean"}, "key": {"type": "boolean"}, "velocity": {"type": "boolean"}, "cc64": {"type": "boolean"}}, "additionalProperties": false},
    "tempo": {"$ref": "#/$defs/eventFact"}, "key": {"$ref": "#/$defs/eventFact"},
    "velocity": {"type": "object", "required": ["note_count", "mean"], "properties": {"note_count": {"type": "integer", "minimum": 1}, "mean": {"type": "number", "minimum": 0}}, "additionalProperties": false},
    "cc64": {"type": "object", "required": ["readable", "present", "format_coverage", "event_count", "interval_count", "unterminated_interval_count", "orphan_release_count", "unavailable_reasons"], "properties": {"readable": {"const": true}, "present": {"type": "boolean"}, "format_coverage": {"$ref": "#/$defs/coverage"}, "event_count": {"type": "integer", "minimum": 0}, "interval_count": {"type": "integer", "minimum": 0}, "unterminated_interval_count": {"type": "integer", "minimum": 0}, "orphan_release_count": {"type": "integer", "minimum": 0}, "unavailable_reasons": {"type": "array", "maxItems": 0}}, "additionalProperties": false},
    "unavailable_reasons": {"type": "array", "items": {"$ref": "#/$defs/reason"}}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "AVAILABLE"}}}, "then": {"required": ["tempo", "key", "velocity", "cc64"], "properties": {"availability": {"properties": {"raw_capture": {"const": true}, "tempo": {"const": true}, "key": {"const": true}, "velocity": {"const": true}, "cc64": {"const": true}}}, "unavailable_reasons": {"maxItems": 0}}}}],
  "$defs": {
    "run": {"type": "object", "required": ["encoding_manifest_sha256", "bar_tensor_index_sha256", "tensor_schema_version"], "properties": {"encoding_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "bar_tensor_index_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "tensor_schema_version": {"const": "bar_tensor_schema.v2"}}, "additionalProperties": false},
    "coverage": {"type": "object", "required": ["song_count", "readable_song_count", "present_song_count"], "properties": {"song_count": {"type": "integer", "minimum": 0}, "readable_song_count": {"type": "integer", "minimum": 0}, "present_song_count": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "eventFact": {"type": "object", "required": ["format_coverage", "event_count"], "properties": {"format_coverage": {"$ref": "#/$defs/coverage"}, "event_count": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "reason": {"type": "object", "required": ["field", "reason"], "properties": {"field": {"type": "string"}, "reason": {"type": "string"}}, "additionalProperties": false}
  }
}
