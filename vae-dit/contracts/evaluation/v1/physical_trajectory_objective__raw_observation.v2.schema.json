{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Physical trajectory objective raw observation v2",
  "description": "Stage 1 runtime facts plus full encoded/window coverage. Evaluation derives metrics, policy and marker.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "trajectory_schema", "coverage", "validation", "probe", "equivariance", "arrays", "availability", "unavailable_reasons"],
  "properties": {
    "schema_version": {"const": "physical_trajectory_objective_raw_observation.v2"},
    "run": {"$ref": "physical_trajectory_objective__raw_status.v2.schema.json#/$defs/run"},
    "trajectory_schema": {"$ref": "#/$defs/trajectory_schema"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "validation": {"$ref": "#/$defs/validation"},
    "probe": {"$ref": "#/$defs/probe"},
    "equivariance": {"$ref": "#/$defs/equivariance"},
    "arrays": {"$ref": "#/$defs/arrays"},
    "availability": {"type": "object", "additionalProperties": false, "required": ["coverage", "validation_reconstruction", "embedding_health", "probe_embeddings", "equivariance"], "properties": {"coverage": {"type": "boolean"}, "validation_reconstruction": {"type": "boolean"}, "embedding_health": {"type": "boolean"}, "probe_embeddings": {"type": "boolean"}, "equivariance": {"type": "boolean"}}},
    "unavailable_reasons": {"$ref": "physical_trajectory_objective__raw_status.v2.schema.json#/$defs/reasons"}
  },
  "$defs": {
    "trajectory_schema": {"type": "object", "additionalProperties": false, "required": ["feature_names", "feature_groups", "plan_bars", "normalizer"], "properties": {"feature_names": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "feature_groups": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}}, "plan_bars": {"type": "integer", "minimum": 1}, "normalizer": {"type": "object", "additionalProperties": false, "required": ["mean", "std", "degenerate"], "properties": {"mean": {"type": "array", "items": {"type": "number"}}, "std": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}}, "degenerate": {"type": "array", "items": {"type": "boolean"}}}}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["encoded_bars", "window_limit", "candidate_windows_before_limit", "selected_windows_after_limit"], "properties": {"encoded_bars": {"type": "object", "additionalProperties": false, "required": ["scope", "count", "missing_base_pitch_count"], "properties": {"scope": {"const": "all_encoded_bar_index_rows_before_window_selection"}, "count": {"type": "integer", "minimum": 1}, "missing_base_pitch_count": {"type": "integer", "minimum": 0}}}, "window_limit": {"type": "object", "additionalProperties": false, "required": ["configured_max_windows", "per_song_max_windows", "global_selection"], "properties": {"configured_max_windows": {"type": ["integer", "null"], "minimum": 1}, "per_song_max_windows": {"type": ["integer", "null"], "minimum": 1}, "global_selection": {"enum": ["none", "linspace_evenly_spaced"]}}}, "candidate_windows_before_limit": {"$ref": "#/$defs/window_distribution"}, "selected_windows_after_limit": {"$ref": "#/$defs/window_distribution"}}},
    "window_distribution": {"type": "object", "additionalProperties": false, "required": ["scope", "count", "base_song_window_counts", "form_window_counts"], "properties": {"scope": {"enum": ["eligible_contiguous_windows_before_per_song_or_global_limit", "training_windows_after_per_song_and_global_limit"]}, "count": {"type": "integer", "minimum": 1}, "base_song_window_counts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["base_song_id", "window_count"], "properties": {"base_song_id": {"type": "string", "minLength": 1}, "window_count": {"type": "integer", "minimum": 1}}}}, "form_window_counts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["form", "window_count"], "properties": {"form": {"type": ["string", "null"]}, "window_count": {"type": "integer", "minimum": 1}}}}}},
    "validation": {"type": "object", "additionalProperties": false, "required": ["window_count", "train_window_count", "validation_window_count", "rows", "corruption"], "properties": {"window_count": {"type": "integer", "minimum": 1}, "train_window_count": {"type": "integer", "minimum": 1}, "validation_window_count": {"type": "integer", "minimum": 1}, "rows": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["row", "base_song_id", "form"], "properties": {"row": {"type": "integer", "minimum": 0}, "base_song_id": {"type": "string", "minLength": 1}, "form": {"type": ["string", "null"]}}}}, "corruption": {"type": "object", "additionalProperties": false, "required": ["seed", "mask_probability", "noise_std"], "properties": {"seed": {"type": "integer"}, "mask_probability": {"type": "number", "minimum": 0, "maximum": 1}, "noise_std": {"type": "number", "minimum": 0}}}}},
    "probe": {"type": "object", "additionalProperties": false, "required": ["sample_count", "variants"], "properties": {"sample_count": {"type": "integer", "minimum": 1}, "variants": {"type": "array", "uniqueItems": true, "minItems": 5, "items": {"enum": ["clean", "coherent_control", "octave_displacement", "track_swap", "boundary_shuffle"]}}}},
    "equivariance": {"type": "object", "additionalProperties": false, "required": ["octave_shift_semitones", "chroma_feature_indices", "density_feature_indices", "pitch_translation_feature_indices"], "properties": {"octave_shift_semitones": {"const": 12.0}, "chroma_feature_indices": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}, "density_feature_indices": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}, "pitch_translation_feature_indices": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}}},
    "arrays": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "items"], "properties": {"path": {"type": "string", "pattern": "^[^\\\\/]+$"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "items": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["dtype", "shape"], "properties": {"dtype": {"enum": ["float32", "bool"]}, "shape": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}}}}}}
  }
}
