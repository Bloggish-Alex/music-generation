{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation/dvae_pitch_supervision_audit__raw_status.v1",
  "title": "DVAE Relative-Pitch Supervision Audit Status",
  "type": "object",
  "required": ["schema_version", "run", "status", "availability", "unavailable_reasons", "artifacts"],
  "properties": {
    "schema_version": {"const": "dvae_pitch_supervision_audit_status.v1"},
    "run": {"$ref": "#/$defs/run"},
    "status": {"enum": ["AVAILABLE", "UNAVAILABLE"]},
    "availability": {"type": "object", "required": ["observation"], "properties": {"observation": {"type": "boolean"}}, "additionalProperties": false},
    "unavailable_reasons": {"$ref": "#/$defs/reasons"},
    "artifacts": {"type": "object", "properties": {"observation": {"$ref": "#/$defs/reference"}}, "additionalProperties": false}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "AVAILABLE"}}}, "then": {"properties": {"availability": {"properties": {"observation": {"const": true}}}, "artifacts": {"required": ["observation"]}}}},
    {"if": {"properties": {"status": {"const": "UNAVAILABLE"}}}, "then": {"properties": {"availability": {"properties": {"observation": {"const": false}}}, "artifacts": {"maxProperties": 0}}}}
  ],
  "$defs": {
    "run": {"type": "object", "required": ["identity", "dataset_identity", "dataset_identity_kind", "seed"], "properties": {"identity": {"type": "string", "minLength": 1}, "dataset_identity": {"type": "string", "minLength": 1}, "dataset_identity_kind": {"type": "string", "minLength": 1}, "seed": {"type": ["integer", "null"]}}, "additionalProperties": false},
    "reference": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"const": "dvae_pitch_supervision_audit__raw.v1.json"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "additionalProperties": false},
    "reasons": {"type": "array", "items": {"type": "object", "required": ["field", "reason"], "properties": {"field": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
