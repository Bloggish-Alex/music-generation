{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controlled history-swap inputs",
  "type": "object",
  "required": ["schema_version", "history_swap", "provenance"],
  "properties": {
    "schema_version": {"const": "trajectory_history_swap_inputs.v1"},
    "history_swap": {"$ref": "#/$defs/reference"},
    "provenance": {"type": "object"}
  },
  "$defs": {"reference": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^sha256:"}}}}
}
