{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation/dataset_tonality__inputs.v1",
  "title": "Dataset Tonality Evaluation Inputs",
  "type": "object",
  "required": ["schema_version", "splits", "availability"],
  "properties": {
    "schema_version": {"const": "dataset_tonality_inputs.v1"},
    "splits": {
      "type": "object",
      "properties": {
        "train": {"$ref": "#/$defs/artifact_reference"},
        "validation": {"$ref": "#/$defs/artifact_reference"},
        "excluded_unpaired": {"$ref": "#/$defs/artifact_reference"}
      },
      "additionalProperties": false
    },
    "availability": {
      "type": "object",
      "required": ["train", "validation"],
      "properties": {
        "train": {"type": "string"},
        "validation": {"type": "string"},
        "excluded_unpaired": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "artifact_reference": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
