{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trajectory attribution raw observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment", "arms", "availability", "unavailable_reasons"],
  "properties": {"schema_version": {"const": "attribution_raw_observation.v1"}, "experiment": {"$ref": "attribution__raw_status.v1.schema.json#/$defs/experiment"}, "arms": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["arm_id", "role", "ablation", "generation_manifest"], "properties": {"arm_id": {"type": "string", "minLength": 1}, "role": {"enum": ["baseline", "ablated"]}, "ablation": {"type": "object", "additionalProperties": false, "required": ["stream", "type"], "properties": {"stream": {"enum": ["theme_memory", "remi", "latent", "register", "physical_trajectory"]}, "type": {"enum": ["natural", "masked", "zero"]}}}, "generation_manifest": {"$ref": "attribution__raw_status.v1.schema.json#/$defs/reference"}}}}, "availability": {"type": "object", "additionalProperties": false, "required": ["paired_arms", "generation_manifests"], "properties": {"paired_arms": {"type": "boolean"}, "generation_manifests": {"type": "boolean"}}}, "unavailable_reasons": {"$ref": "attribution__raw_status.v1.schema.json#/$defs/reasons"}}
}
